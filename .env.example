# 复制本文件为 .env 后填入真实密钥；.env 已被 .gitignore 排除，不会进入仓库。

# ===== 大模型（默认 DeepSeek，也可换成任意 OpenAI 兼容服务）=====
# 申请地址：https://platform.deepseek.com
DEEP_API_KEY=your-deepseek-api-key

# ===== 百度智能云语音识别（短语音识别）=====
# 申请地址：https://console.bce.baidu.com/ai/ （语音技术 → 短语音识别）
VOICE_API_KEY=your-baidu-api-key
SECRET_API_KEY=your-baidu-secret-key

# ===== 魔搭 ModelScope（可选：远程 MCP SSE 服务）=====
MODELSCOPE_API_KEY=your-modelscope-token

# ===== 智谱 GLM（可选，当前默认使用 OpenAI SDK 接入 DeepSeek）=====
Zai_API_KEY=your-zhipu-api-key
